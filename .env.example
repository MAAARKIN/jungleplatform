# HTTP
HTTP_ADDR=:8080

# PostgreSQL
POSTGRES_DSN=postgres://jungle:jungle@localhost:5432/jungle?sslmode=disable

# SQS (LocalStack)
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Keycloak (OAuth 2.0 / OIDC, client_credentials)
KEYCLOAK_ISSUER_URL=http://localhost:8180/realms/jungle
KEYCLOAK_CLIENT_ID=internal
KEYCLOAK_CLIENT_SECRET=internal-secret

# Worker behavior
WORKER_MODE=worker
SHUTDOWN_GRACE=5s

# Pending reference resolution
PENDING_REF_TTL=24h